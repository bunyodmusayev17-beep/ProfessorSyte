# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust for your machine.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Where the browser sends API calls.
# Leave as /api so requests stay same-origin (Vite proxy in dev, nginx in prod).
VITE_API_BASE_URL=/api

# Dev only: the ASP.NET Core backend that Vite proxies /api and /uploads to.
# Check the URL printed by `dotnet run` (see Properties/launchSettings.json).
VITE_API_PROXY_TARGET=https://localhost:7223

# Brand name shown in the sidebar and page title.
VITE_APP_NAME=TechnoVolt
